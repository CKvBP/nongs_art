# Local preview only. Ignored on Vercel and in production.
LOCAL_ADMIN_PREVIEW=true

# Set these in Vercel before deployment. Use a long, unique admin password.
ADMIN_USERNAME=nong
ADMIN_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Neon pooled connection string from the Vercel Marketplace integration.
DATABASE_URL=
# Public Vercel Blob store, used only for artwork published to the website.
BLOB_READ_WRITE_TOKEN=

# Separate PRIVATE Vercel Blob store for customer reference photos.
REFERENCE_BLOB_READ_WRITE_TOKEN=

# Gmail sending: Production only; enable after verifying the Gmail sender alias.
EMAIL_ENABLED=false
GMAIL_USER=nong@buedingen.us
# Google app password, entered directly in Vercel as a secret.
GMAIL_APP_PASSWORD=
EMAIL_FROM=hello@nongsartden.com
STUDIO_NOTIFICATION_EMAIL=nong@buedingen.us
# Random secret for Vercel's authenticated cron requests.
CRON_SECRET=
